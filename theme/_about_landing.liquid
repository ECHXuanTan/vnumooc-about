<!-- 04 EXPERIENCE -->
<section id="trai-nghiem">
  <div class="wrap exp-grid">
    <div>
      <span class="eyebrow reveal">{% if ui_lang == 'en' %}The digital learning experience{% else %}Trải nghiệm học tập số{% endif %}</span>
      <h2 class="title reveal d1">{% if ui_lang == 'en' %}Designed for the digital space{% else %}Được thiết kế cho môi trường số{% endif %}</h2>
      <p class="lead reveal d2">{% if ui_lang == 'en' %}Each course features video lectures, learning materials, interactive activities, and discussions, empowering learners to learn, practice, and reinforce their knowledge.{% else %}Mỗi môn học gồm video bài giảng, học liệu, hoạt động tương tác và thảo luận, giúp người học vừa học, vừa thực hành và tự củng cố kiến thức.{% endif %}</p>
      <div class="features">
        <div class="feat reveal d1">
          <div class="ic"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
          <h3>{% if ui_lang == 'en' %}Short, focused lessons{% else %}Bài giảng ngắn, tập trung{% endif %}</h3>
          <p>{% if ui_lang == 'en' %}Learn essential concepts in bite-sized lessons of no more than 15 minutes.{% else %}Các bài giảng có thời lượng không quá 15 phút, tập trung vào những nội dung trọng tâm.{% endif %}</p>
        </div>
        <div class="feat reveal d2">
          <div class="ic"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"/></svg></div>
          <h3>{% if ui_lang == 'en' %}Interactive activities{% else %}Hoạt động tương tác{% endif %}</h3>
          <p>{% if ui_lang == 'en' %}Apply what you learn through interactive exercises and activities.{% else %}Vừa học, vừa thực hành và tự củng cố kiến thức.{% endif %}</p>
        </div>
        <div class="feat reveal d3">
          <div class="ic"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
          <h3>{% if ui_lang == 'en' %}Discuss with lecturers and peers{% else %}Thảo luận cùng giảng viên và bạn học{% endif %}</h3>
          <p>{% if ui_lang == 'en' %}Exchange ideas, ask questions, and learn from lecturers and fellow learners.{% else %}Trao đổi, đặt câu hỏi và học hỏi lẫn nhau.{% endif %}</p>
        </div>
        <div class="feat reveal d4">
          <div class="ic"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3zM3 19a2 2 0 0 0 2 2h1v-6H3z"/></svg></div>

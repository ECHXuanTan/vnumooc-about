<!-- 05 JOURNEY -->
<section class="journey" id="hanh-trinh">
  <div class="wrap">
    <span class="eyebrow reveal">{% if ui_lang == 'en' %}Alongside learners{% else %}Đồng hành cùng người học{% endif %}</span>
    <h2 class="title reveal d1">{% if ui_lang == 'en' %}From the first stepping stone to your entire knowledge journey{% else %}Từ bước đệm đầu tiên đến suốt hành trình tri thức{% endif %}</h2>
    <p class="lead reveal d2">{% if ui_lang == 'en' %}The{% else %}Hệ thống{% endif %} <span class="nw">VNU-MOOC</span> {% if ui_lang == 'en' %}platform accompanies you at every stage—from your initial days of adapting to the digital environment to the opportunity of integrating your learning achievements with official academic pathways.{% else %}hiện diện ở từng chặng – từ những ngày đầu làm quen với môi trường số đến cơ hội gắn kết kết quả học tập với lộ trình đào tạo chính thức.{% endif %}</p>

    <div class="journey-grid">
      <div class="tstep reveal">
        <div class="tcard">
          <div class="tthumb s1"><div class="subj"><big>⚛</big>{% if ui_lang == 'en' %}Physics{% else %}Vật lý{% endif %}</div><div class="subj"><big>⚗</big>{% if ui_lang == 'en' %}Chemistry{% else %}Hóa học{% endif %}</div><div class="subj"><big>🧬</big>{% if ui_lang == 'en' %}Biology{% else %}Sinh học{% endif %}</div></div>
          <h3>{% if ui_lang == 'en' %}Reinforce foundations{% else %}Củng cố nền tảng{% endif %}</h3>
          <p>{% if ui_lang == 'en' %}Foundation MOOC courses in Physics, Chemistry, and Biology help learners review and consolidate essential knowledge, preparing them thoroughly before embarking on a new academic chapter.{% else %}Các môn học MOOC bổ trợ kiến thức nền tảng về Vật lý, Hóa học và Sinh học giúp người học rà soát, củng cố những kiến thức cần thiết và chuẩn bị tốt hơn trước khi bắt đầu chặng đường mới.{% endif %}</p>
        </div>
      </div>
      <div class="tstep reveal d1">
        <div class="tcard">
          <div class="tthumb s2"><div class="tags"><em>{% if ui_lang == 'en' %}Political theory{% else %}Lý luận chính trị{% endif %}</em><em>{% if ui_lang == 'en' %}Information technology{% else %}Công nghệ thông tin{% endif %}</em><em>{% if ui_lang == 'en' %}Basic sciences{% else %}Khoa học cơ bản{% endif %}</em><em>{% if ui_lang == 'en' %}Social sciences{% else %}Khoa học xã hội{% endif %}</em><em>{% if ui_lang == 'en' %}Economics &amp; business{% else %}Kinh tế - kinh doanh{% endif %}</em><em>{% if ui_lang == 'en' %}Health{% else %}Sức khỏe{% endif %}</em></div></div>
          <h3>{% if ui_lang == 'en' %}Expand your choices{% else %}Mở rộng lựa chọn{% endif %}</h3>
          <p>{% if ui_lang == 'en' %}Discover courses across a wide range of fields, including Political Theory, Information Technology, Basic Sciences, Social Sciences, Economics and Business, and Health.{% else %}Khám phá các môn thuộc nhiều lĩnh vực: lý luận chính trị, công nghệ thông tin, khoa học cơ bản, khoa học xã hội, kinh tế - kinh doanh, sức khỏe…{% endif %}</p>
        </div>
      </div>
      <div class="tstep reveal d2">
        <div class="tcard">
          <div class="tthumb s3"><div class="subj" style="flex:none;width:70%;text-align:center"><big>⇄</big>{% if ui_lang == 'en' %}MOOC + formal study{% else %}MOOC + chính khóa{% endif %}</div></div>
          <h3>{% if ui_lang == 'en' %}Learn flexibly{% else %}Học tập linh hoạt{% endif %}</h3>
          <p>{% if ui_lang == 'en' %}Integrate MOOC courses into your learning journey flexibly and at your own pace.{% else %}Kết hợp các môn học MOOC vào quá trình học tập một cách linh hoạt, chủ động theo tiến độ cá nhân.{% endif %}</p>
        </div>
      </div>
      <div class="tstep reveal d3">
        <div class="tcard">
          <div class="tthumb s4"><div class="subj" style="flex:none;width:70%;text-align:center"><big>✓</big>{% if ui_lang == 'en' %}Credit recognition and transfer{% else %}Công nhận và chuyển đổi tín chỉ{% endif %}</div></div>
          <h3>{% if ui_lang == 'en' %}Align with academic pathways{% else %}Gắn với lộ trình đào tạo{% endif %}</h3>
          <p>{% if ui_lang == 'en' %}Your MOOC learning outcomes are eligible for credit recognition or transfer, subject to applicable regulations.{% else %}Kết quả học tập từ các môn học MOOC được các cơ sở đào tạo thuộc ĐHQG-HCM xem xét công nhận và chuyển đổi tín chỉ vào chương trình đào tạo chính khóa bậc đại học tại các trường đại học thành viên.{% endif %}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Ba hình thức học tập -->
<section id="hinh-thuc" class="learning-modes" aria-labelledby="modes-title">
  <div class="wrap">
    <span class="eyebrow reveal">{% if ui_lang == 'en' %}Learning modes{% else %}Hình thức học tập{% endif %}</span>
    <h2 class="title reveal d1" id="modes-title">{% if ui_lang == 'en' %}Three learning modes{% else %}Ba hình thức học tập{% endif %}</h2>
    <div class="audience-grid">
      <article class="audience-card reveal"><span class="audience-index">01</span><h3>{% if ui_lang == 'en' %}Supplementary learning{% else %}Học liệu bổ trợ{% endif %}</h3><p>{% if ui_lang == 'en' %}Learners proactively engage in extra study to consolidate knowledge, reinforce weaker areas, or explore new fields of interest.{% else %}Người học chủ động học thêm để củng cố kiến thức, bổ sung những nội dung còn chưa vững hoặc khám phá một lĩnh vực mới.{% endif %}</p></article>
      <article class="audience-card reveal d1"><span class="audience-index">02</span><h3>{% if ui_lang == 'en' %}Blended learning{% else %}Học tập kết hợp (Blended Learning){% endif %}</h3><p>{% if ui_lang == 'en' %}Learners cover specific content on the{% else %}Người học tiếp thu một phần nội dung trên Hệ thống{% endif %} <span class="nw">VNU-MOOC</span>{% if ui_lang == 'en' %} platform before participating in live discussions, practical sessions, and direct interactions with instructors.{% else %}, sau đó tiếp tục thảo luận, thực hành và tương tác trực tiếp với giảng viên.{% endif %}</p></article>
      <article class="audience-card reveal d2"><span class="audience-index">03</span><h3>{% if ui_lang == 'en' %}Credit accumulation{% else %}Học và tích lũy tín chỉ{% endif %}</h3><p>{% if ui_lang == 'en' %}Learners complete course requirements, clear independent assessments, and earn official academic credits in accordance with regulations.{% else %}Người học hoàn thành học phần, tham gia kiểm tra, đánh giá độc lập và được xem xét công nhận, tích lũy tín chỉ theo quy định.{% endif %}</p></article>
    </div>
  </div>
</section>

<!-- Merged: đối tượng + giá trị + định hướng (trước đây là 3 section riêng, nội dung trùng lặp) -->
<section id="gia-tri" class="audience" aria-labelledby="audience-title">
  <div class="wrap">
    <span class="eyebrow reveal">{% if ui_lang == 'en' %}Who it's for, and the value it brings{% else %}Dành cho ai, mang lại giá trị gì{% endif %}</span>
    <h2 class="title reveal" id="audience-title">{% if ui_lang == 'en' %}Who is{% else %}Hệ thống{% endif %} <span class="nw">VNU-MOOC</span> {% if ui_lang == 'en' %}for, and what value does it bring?{% else %}dành cho ai, mang lại giá trị gì?{% endif %}</h2>
    <p class="lead reveal">{% if ui_lang == 'en' %}Serving three primary groups, driven by four core values: proactive, flexible, connected, and transferable.{% else %}Phục vụ ba nhóm đối tượng chính, với bốn giá trị cốt lõi xuyên suốt: chủ động, linh hoạt, kết nối và liên thông.{% endif %}</p>

    <div class="audience-grid">
      <article class="audience-card reveal"><span class="audience-index">01</span><h3>{% if ui_lang == 'en' %}Learners{% else %}Người học{% endif %}</h3><p>{% if ui_lang == 'en' %}Take ownership of their learning journey.{% else %}Chủ động xây dựng hành trình học tập của mình.{% endif %}</p><ul><li>{% if ui_lang == 'en' %}Reinforce foundational knowledge.{% else %}Củng cố kiến thức nền tảng.{% endif %}</li><li>{% if ui_lang == 'en' %}Learn at their own pace.{% else %}Học theo tiến độ cá nhân.{% endif %}</li><li>{% if ui_lang == 'en' %}Explore new fields.{% else %}Khám phá thêm lĩnh vực mới.{% endif %}</li><li>{% if ui_lang == 'en' %}Integrate online learning into their degree program.{% else %}Kết hợp học trực tuyến với chương trình đào tạo.{% endif %}</li></ul><a class="text-link" href="#hanh-trinh">{% if ui_lang == 'en' %}Explore your learning journey{% else %}Khám phá hành trình học tập{% endif %} <span aria-hidden="true">↗</span></a></article>

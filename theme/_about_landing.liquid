{%- comment -%}
  _about_landing.liquid — Trang giới thiệu VNU-MOOC (landing cho khách chưa đăng nhập).
  Nguồn: ./vnumooc-about/index.html. Assets: 2/assets/about/* qua asset_url.
  Ẩn header/footer theme (.k12-hdr/.k12-ft) để dùng nav riêng của trang About.
{%- endcomment -%}

{%- assign ui_lang = 'about._locale' | translate -%}

{%- comment -%} Patrick Hand (decorative), Oswald (danh mục môn) — Be Vietnam Pro + Open Sans đã self-host trong fonts.google.css {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&family=Patrick+Hand&display=swap" rel="stylesheet">

<style>
  :root{
    --font-body:"Open Sans","Google Sans","Inter",system-ui,-apple-system,sans-serif;
    --font-display:"Be Vietnam Pro","Google Sans","Inter",system-ui,-apple-system,sans-serif;
    --navy:#14213d;
    --blue:#1d3faf;
    --blue-2:#3d63d6;
    --sky:#e7ecf8;
    --accent:#d7263d;
    --accent-2:#ffe27a;
    --ink:#1a2238;
    --muted:#535d74;
    --line:#d6deeb;
    --rule:#c9d3ee;
    --bg:#fafbfd;
    --bg-soft:#f0f3f9;
    --radius:20px;
    --max:1180px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--font-body);color:var(--ink);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  img{max-width:100%;display:block}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:var(--max);margin:0 auto;padding:0 24px}
  .eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--blue)}
  .eyebrow::before{content:"";width:28px;height:2px;background:currentColor}
  h2.title{font-size:clamp(28px,4vw,46px);line-height:1.15;font-weight:800;letter-spacing:-.02em;margin:14px 0 18px;text-wrap:balance}
  .lead{font-size:clamp(16px,1.6vw,19px);color:var(--muted);max-width:640px}
  section{padding:clamp(72px,10vw,128px) 0;position:relative}

  /* reveal */
  .js-ready .reveal{opacity:0;transform:translateY(28px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1)}
  .js-ready .reveal.in{opacity:1;transform:none}
  .d1{transition-delay:.1s}.d2{transition-delay:.2s}.d3{transition-delay:.3s}.d4{transition-delay:.4s}
  @media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}

  /* NAV */
  .nav{position:fixed;inset:0 0 auto 0;z-index:50;transition:background .3s,box-shadow .3s}
  .nav .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}
  .logo{display:flex;align-items:center;background:#fff;border-radius:12px;padding:6px 12px}
  .logo img{height:38px;width:auto;display:block}
  .nav-links{display:flex;gap:28px;font-size:14px;font-weight:500;color:rgba(255,255,255,.85)}
  .nav-links a:hover{color:#fff}
  .nav.scrolled{background:rgba(255,255,255,.92);backdrop-filter:blur(12px);box-shadow:0 1px 0 var(--line)}
  .nav.scrolled .logo{color:var(--navy)}
  .nav.scrolled .nav-links{color:var(--muted)}
  .nav.scrolled .nav-links a:hover{color:var(--blue)}
  .btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:999px;font-weight:600;font-size:15px;transition:transform .2s,box-shadow .2s,background .2s;cursor:pointer;border:0}
  .btn:hover{transform:translateY(-2px)}
  .btn-primary{background:var(--accent);color:var(--navy);box-shadow:0 10px 30px -10px rgba(255,176,32,.7)}
  .btn-ghost{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.35)}
  .btn-ghost:hover{background:rgba(255,255,255,.18)}
  .nav .btn{padding:10px 20px;font-size:14px}
  .nav-actions{display:flex;align-items:center;gap:10px}
  .nw{white-space:nowrap}
  .vm-core-kicker{position:relative;display:block;margin-bottom:6px;color:rgba(255,255,255,.82);font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .nav-lang{position:relative}
  .nav-lang>summary{list-style:none;display:inline-flex;align-items:center;gap:7px;cursor:pointer;padding:8px 12px;border:1px solid var(--rule);border-radius:999px;color:var(--muted);background:rgba(255,255,255,.6);font-size:13px;font-weight:700;line-height:1;transition:color .2s,border-color .2s}
  .nav-lang>summary::-webkit-details-marker{display:none}
  .nav-lang>summary:hover{color:var(--blue);border-color:var(--blue)}
  .nav-lang__globe{width:18px;height:18px;flex:none}
  .nav-lang__chev{width:13px;height:13px;flex:none;transition:transform .25s}
  .nav-lang[open] .nav-lang__chev{transform:rotate(180deg)}
  .nav-lang__pop{position:absolute;right:0;top:calc(100% + 8px);min-width:158px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 16px 40px -16px rgba(10,42,94,.35);padding:6px;display:flex;flex-direction:column;gap:2px;z-index:60}
  .nav-lang__pop a{padding:10px 12px;border-radius:8px;font-size:14px;font-weight:600;color:var(--ink)}
  .nav-lang__pop a:hover{background:var(--bg-soft);color:var(--blue)}
  .nav-lang__pop a.is-active{background:var(--sky);color:var(--blue)}
  @media (max-width:860px){.nav-links{display:none}}

  /* 01 HERO */
  .hero{min-height:100vh;min-height:100svh;display:flex;align-items:center;padding:120px 0 80px;color:#fff;overflow:hidden;
    background:radial-gradient(1200px 600px at 85% 20%,rgba(47,124,246,.55),transparent 60%),
               radial-gradient(800px 500px at 10% 90%,rgba(255,122,69,.28),transparent 60%),
               linear-gradient(160deg,#06173a 0%,var(--navy) 55%,#0e3a86 100%)}
  .hero::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:56px 56px;mask-image:radial-gradient(ellipse at 70% 40%,#000 20%,transparent 70%);pointer-events:none}
  .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;position:relative;z-index:1}
  .hero .eyebrow{color:var(--accent)}
  .hero h1{font-size:clamp(38px,6vw,72px);line-height:1.05;font-weight:800;letter-spacing:-.03em;margin:18px 0 24px}
  .hero h1 span{display:block}
  .hero h1 .hl{background:linear-gradient(90deg,var(--accent),var(--accent-2));-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p{font-size:clamp(16px,1.5vw,19px);color:rgba(255,255,255,.78);max-width:560px;margin-bottom:36px}
  .hero-cta{display:flex;flex-wrap:wrap;gap:14px}
  .scroll-hint{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);z-index:1;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.6);display:flex;flex-direction:column;align-items:center;gap:10px}
  .scroll-hint i{width:1px;height:40px;background:linear-gradient(rgba(255,255,255,.7),transparent);animation:drip 2s infinite}
  @keyframes drip{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

  /* hero visual: cycling story cards */
  .stage{position:relative;aspect-ratio:4/4.2;max-width:480px;margin-left:auto;width:100%;border-radius:28px;overflow:hidden;box-shadow:0 40px 80px -30px rgba(0,0,0,.5)}
  .scene{position:absolute;inset:0;border-radius:28px;padding:26px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(8px);display:flex;flex-direction:column;opacity:0;transform:translateX(104%);transition:opacity .6s cubic-bezier(.4,0,.2,1),transform .6s cubic-bezier(.4,0,.2,1)}
  .scene.active{opacity:1;transform:translateX(0)}
  .scene.prev{opacity:0;transform:translateX(-104%)}
  .scene-tag{font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}
  .scene-body{flex:1;border-radius:18px;background:rgba(255,255,255,.95);color:var(--ink);padding:20px;display:flex;flex-direction:column;gap:12px;overflow:hidden}
  .ph-video{flex:1;border-radius:12px;background:linear-gradient(135deg,#1c4aa0,#3a86ff);display:grid;place-items:center;position:relative;min-height:140px}
  .ph-video .play{width:62px;height:62px;border-radius:50%;background:rgba(255,255,255,.95);display:grid;place-items:center;box-shadow:0 10px 30px rgba(0,0,0,.25)}
  .ph-video .play::after{content:"";border-left:18px solid var(--blue);border-top:11px solid transparent;border-bottom:11px solid transparent;margin-left:5px}
  .ph-video .dur{position:absolute;right:10px;bottom:10px;font-size:11px;font-weight:600;background:rgba(0,0,0,.55);color:#fff;padding:3px 8px;border-radius:6px}
  .bar{height:10px;border-radius:6px;background:var(--line)}
  .bar.w70{width:70%}.bar.w50{width:50%}.bar.w85{width:85%}
  .quiz-q{font-weight:700;font-size:15px}
  .opt{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:12px;border:1.5px solid var(--line);font-size:14px}
  .opt.ok{border-color:#22b573;background:#eafaf2}
  .opt b{width:22px;height:22px;border-radius:50%;border:1.5px solid currentColor;display:grid;place-items:center;font-size:11px;flex:none;color:var(--muted)}
  .opt.ok b{background:#22b573;border-color:#22b573;color:#fff}
  .person{display:flex;align-items:center;gap:12px}
  .avatar{width:44px;height:44px;border-radius:50%;flex:none;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:grid;place-items:center;font-weight:700;color:#fff}
  .avatar.b{background:linear-gradient(135deg,var(--blue-2),var(--blue))}
  .avatar.g{background:linear-gradient(135deg,#22b573,#0c8a55)}
  .course-row{display:flex;gap:10px;align-items:center;padding:10px;border-radius:12px;background:var(--bg-soft)}
  .course-thumb{width:48px;height:40px;border-radius:8px;flex:none}
  .progress{height:6px;border-radius:4px;background:var(--line);overflow:hidden;margin-top:6px}
  .progress i{display:block;height:100%;background:var(--blue-2);border-radius:4px}
  .dots{position:absolute;bottom:-34px;left:0;display:flex;gap:8px}
  .dots span{width:8px;height:8px;border-radius:4px;background:rgba(255,255,255,.3);transition:width .4s,background .4s}
  .dots span.on{width:26px;background:var(--accent)}
  @media (max-width:960px){.hero-grid{grid-template-columns:1fr}.stage{margin:20px auto 30px;max-width:420px}}

  /* manifesto */
  .manifesto{padding:clamp(60px,8vw,96px) 0;background:var(--bg-soft);text-align:center}
  .manifesto p{font-size:clamp(22px,3vw,34px);font-weight:700;line-height:1.35;letter-spacing:-.015em;max-width:900px;margin:0 auto;text-wrap:balance}
  .manifesto p em{font-style:normal;color:var(--muted);font-weight:500}
  .manifesto p strong{color:var(--blue)}

  /* 02 NUMBERS */
  .numbers-head{display:flex;justify-content:space-between;align-items:end;gap:40px;flex-wrap:wrap;margin-bottom:56px}
  .milestones{display:grid;grid-template-columns:1fr 1fr;gap:0;position:relative;margin-bottom:28px;border-radius:var(--radius);background:var(--navy);color:#fff;overflow:hidden}
  .milestone{padding:34px 36px;position:relative}
  .milestone + .milestone{border-left:1px dashed rgba(255,255,255,.25)}
  .milestone .yr{font-size:clamp(34px,4.5vw,52px);font-weight:800;letter-spacing:-.02em;line-height:1;color:var(--accent)}
  .milestone p{color:rgba(255,255,255,.8);margin-top:12px;max-width:380px}
  .milestone .arrow{position:absolute;right:-18px;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;background:var(--accent);color:var(--navy);display:grid;place-items:center;font-weight:800;z-index:2}
  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .stat{padding:36px 32px;border-radius:var(--radius);background:var(--bg);border:1px solid var(--line);position:relative;overflow:hidden}
  .stat::before{content:"";position:absolute;left:0;top:0;height:4px;width:100%;background:linear-gradient(90deg,var(--blue),var(--blue-2))}
  .stat:nth-child(3)::before{background:linear-gradient(90deg,var(--accent),var(--accent-2))}
  .stat .num{font-size:clamp(56px,7vw,88px);font-weight:800;letter-spacing:-.04em;line-height:1;color:var(--navy);font-variant-numeric:tabular-nums}
  .stat .num small{font-size:.38em;font-weight:700;letter-spacing:0;color:var(--muted);display:block;margin-bottom:6px}
  .stat p{margin-top:14px;color:var(--muted);font-weight:500}
  @media (max-width:860px){.milestones,.stats{grid-template-columns:1fr}.milestone + .milestone{border-left:0;border-top:1px dashed rgba(255,255,255,.25)}.milestone .arrow{right:auto;left:36px;top:auto;bottom:-18px;transform:rotate(90deg)}}

  /* 03 COMMUNITY */
  .community{background:var(--bg-soft)}
  .community-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
  .collage{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:120px;gap:14px}
  .ph{border-radius:18px;position:relative;overflow:hidden;display:flex;align-items:flex-end;padding:14px;color:#fff;font-size:12px;font-weight:600}
  .ph::after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 40%,rgba(0,0,0,.35))}
  .ph span{position:relative;z-index:1}
  .ph .sil{position:absolute;left:50%;bottom:-10%;transform:translateX(-50%);width:56%;aspect-ratio:1/1.2}
  .ph .sil::before{content:"";position:absolute;left:50%;top:0;transform:translateX(-50%);width:46%;aspect-ratio:1;border-radius:50%;background:rgba(255,255,255,.35)}
  .ph .sil::after{content:"";position:absolute;left:0;right:0;bottom:0;height:52%;border-radius:50% 50% 0 0;background:rgba(255,255,255,.35)}
  .c1{grid-row:span 2;background:linear-gradient(160deg,#2f7cf6,#0a2a5e)}
  .c2{background:linear-gradient(160deg,#ffb020,#ff7a45)}
  .c3{background:linear-gradient(160deg,#22b573,#0c6e46)}
  .c4{grid-column:span 2;background:linear-gradient(160deg,#6c5ce7,#2d2a7a)}
  .c5{background:linear-gradient(160deg,#1552b5,#34a0ff)}
  .c6{grid-column:span 2;background:linear-gradient(160deg,#0a2a5e,#1c4aa0)}
  .process{margin-top:32px;display:grid;gap:14px}
  .step{display:flex;gap:16px;align-items:flex-start;padding:18px 20px;border-radius:16px;background:#fff;border:1px solid var(--line)}
  .step .n{flex:none;width:36px;height:36px;border-radius:10px;background:var(--sky);color:var(--blue);font-weight:800;display:grid;place-items:center;font-size:14px}
  .step h3{font-size:16px;font-weight:700}
  .step p{font-size:14px;color:var(--muted)}
  .logo-strip{margin-top:72px;border-top:1px solid var(--line);padding-top:36px;overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)}
  .logo-strip small{display:block;text-align:center;color:var(--muted);font-size:13px;margin-bottom:22px;letter-spacing:.08em;text-transform:uppercase;font-weight:600}
  .marquee{display:flex;gap:18px;width:max-content;animation:marq 38s linear infinite}
  .marquee span{white-space:nowrap;padding:14px 24px;border-radius:14px;background:#fff;border:1px solid var(--line);font-weight:600;color:var(--navy);font-size:14px}
  @keyframes marq{to{transform:translateX(-50%)}}
  @media (max-width:960px){.community-grid{grid-template-columns:1fr;gap:48px}}

  /* 04 EXPERIENCE */
  .exp-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}
  .devices{position:relative;padding-bottom:40px}
  .laptop{background:#1b2436;border-radius:18px 18px 6px 6px;padding:14px 14px 18px;box-shadow:0 40px 80px -30px rgba(10,42,94,.45)}
  .screen{background:#fff;border-radius:8px;overflow:hidden;aspect-ratio:16/10;display:grid;grid-template-columns:1.6fr 1fr}
  .screen-main{padding:14px;display:flex;flex-direction:column;gap:10px;border-right:1px solid var(--line)}
  .screen-side{padding:14px;display:flex;flex-direction:column;gap:8px;background:var(--bg-soft)}
  .laptop-base{height:14px;background:linear-gradient(#cfd6e2,#aab4c5);border-radius:0 0 18px 18px;margin:0 -30px}
  .chip{font-size:10px;font-weight:700;padding:4px 8px;border-radius:6px;background:var(--sky);color:var(--blue);width:max-content}
  .lesson{display:flex;gap:8px;align-items:center;font-size:10px;color:var(--muted);padding:6px 8px;border-radius:6px;background:#fff}
  .lesson i{width:8px;height:8px;border-radius:50%;background:var(--line);flex:none}
  .lesson.done i{background:#22b573}
  .lesson.now{outline:1.5px solid var(--blue-2);color:var(--ink);font-weight:600}
  .lesson.now i{background:var(--blue-2)}
  .phone{position:absolute;right:-10px;bottom:0;width:34%;min-width:150px;background:#1b2436;border-radius:26px;padding:8px;box-shadow:0 30px 60px -20px rgba(10,42,94,.5)}
  .phone-screen{background:#fff;border-radius:20px;padding:14px 12px;display:flex;flex-direction:column;gap:8px;aspect-ratio:9/17}
  .msg{font-size:10px;padding:8px 10px;border-radius:12px;background:var(--bg-soft);line-height:1.4}
  .msg.me{background:var(--blue-2);color:#fff;align-self:flex-end;border-bottom-right-radius:4px}
  .msg.t{border-bottom-left-radius:4px}
  .msg b{display:block;font-size:9px;opacity:.7;margin-bottom:2px}
  .features{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:36px}
  .feat{padding:24px;border-radius:18px;border:1px solid var(--line);background:#fff;transition:border-color .25s,box-shadow .25s,transform .25s}
  .feat:hover{border-color:var(--blue-2);box-shadow:0 16px 40px -20px rgba(21,82,181,.35);transform:translateY(-3px)}
  .feat .ic{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;margin-bottom:16px;background:var(--sky);color:var(--blue)}
  .feat .ic svg{width:22px;height:22px}
  .feat h3{font-size:17px;font-weight:700;margin-bottom:6px;line-height:1.3}
  .feat p{font-size:14px;color:var(--muted)}
  @media (max-width:960px){.exp-grid{grid-template-columns:1fr}.devices{order:-1;max-width:560px;margin:0 auto;width:100%}}
  @media (max-width:560px){.features{grid-template-columns:1fr}.phone{right:0}.laptop-base{margin:0 -8px}}

  /* 05 JOURNEY */
  .journey{background:var(--navy);color:#fff;overflow:hidden}
  .journey .eyebrow{color:var(--accent)}
  .journey .lead{color:rgba(255,255,255,.72)}
  .timeline{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:64px}
  .timeline::before{content:"";position:absolute;left:0;right:0;top:27px;height:2px;background:rgba(255,255,255,.15)}
  .timeline .track{position:absolute;left:0;top:27px;height:2px;width:0;background:linear-gradient(90deg,var(--accent),var(--accent-2));transition:width 1.8s cubic-bezier(.3,.7,.2,1)}
  .timeline.in .track{width:100%}
  .tstep{position:relative}
  .tdot{width:56px;height:56px;border-radius:50%;background:var(--navy);border:2px solid var(--accent);display:grid;place-items:center;font-weight:800;color:var(--accent);position:relative;z-index:1;margin-bottom:26px}
  .tcard{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:18px;height:calc(100% - 82px)}
  .tthumb{height:110px;border-radius:12px;margin-bottom:16px;display:flex;align-items:center;justify-content:center;gap:8px;padding:10px}
  .tthumb.s1{background:linear-gradient(135deg,#1c4aa0,#2f7cf6)}
  .tthumb.s2{background:linear-gradient(135deg,#6c5ce7,#a29bfe);height:auto;min-height:110px}
  .tthumb.s3{background:linear-gradient(135deg,#0c8a55,#22b573)}
  .tthumb.s4{background:linear-gradient(135deg,#ff7a45,#ffb020)}
  .subj{flex:1;height:100%;border-radius:10px;background:rgba(255,255,255,.18);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:12px;font-weight:700;gap:4px}
  .subj big{font-size:22px;line-height:1}
  .tags{display:flex;flex-wrap:wrap;gap:6px;justify-content:center}
  .tags em{font-style:normal;font-size:10px;font-weight:600;padding:4px 8px;border-radius:999px;background:rgba(255,255,255,.22)}
  .tstep small{font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
  .tstep h3{font-size:19px;font-weight:700;margin:4px 0 8px;line-height:1.3}
  .tstep p{font-size:14px;color:rgba(255,255,255,.72)}
  @media (max-width:960px){
    .timeline{grid-template-columns:1fr;gap:28px;padding-left:76px}
    .timeline::before,.timeline .track{left:27px;top:0;bottom:0;width:2px;height:auto}
    .timeline .track{height:0;bottom:auto;transition:height 1.8s cubic-bezier(.3,.7,.2,1)}
    .timeline.in .track{width:2px;height:100%}
    .tdot{position:absolute;left:-76px;top:0;margin:0}
    .tcard{height:auto}
  }

  /* Giá trị cốt lõi — dải thẻ gọn trong section "dành cho ai / giá trị gì" */
  .pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:48px}
  .pillar{position:relative;border-radius:18px;min-height:210px;padding:20px;display:flex;flex-direction:column;justify-content:flex-end;color:#fff;overflow:hidden;isolation:isolate;transition:transform .35s}
  .pillar:hover{transform:translateY(-4px)}
  .pillar::before{content:"";position:absolute;inset:0;z-index:-1;transition:transform .6s}
  .pillar:hover::before{transform:scale(1.06)}
  .pillar::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(transparent 30%,rgba(6,23,58,.75))}
  .p1::before{background:radial-gradient(circle at 70% 25%,rgba(255,255,255,.25) 0 60px,transparent 61px),linear-gradient(160deg,#2f7cf6,#0a2a5e)}
  .p2::before{background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.22) 0 80px,transparent 81px),linear-gradient(160deg,#ffb020,#e0512a)}
  .p3::before{background:radial-gradient(circle at 25% 25%,rgba(255,255,255,.25) 0 30px,transparent 31px),radial-gradient(circle at 70% 35%,rgba(255,255,255,.2) 0 40px,transparent 41px),linear-gradient(160deg,#22b573,#0a4f33)}
  .p4::before{background:repeating-linear-gradient(135deg,rgba(255,255,255,.08) 0 14px,transparent 14px 28px),linear-gradient(160deg,#6c5ce7,#241f63)}
  .pillar .idx{position:absolute;top:16px;left:18px;font-size:12px;font-weight:700;opacity:.8}
  .pillar .icon-lg{position:absolute;top:14px;right:16px;width:30px;height:30px;opacity:.9}
  .pillar h3{font-size:clamp(16px,1.4vw,19px);font-weight:800;letter-spacing:.02em;line-height:1.15;margin-bottom:6px}
  .pillar p{font-size:13px;color:rgba(255,255,255,.88)}
  .vision-note{margin-top:44px;padding-top:26px;border-top:1px solid var(--line);font-size:15px;color:var(--muted);max-width:760px}
  .vision-note strong{color:var(--navy);font-weight:700}
  @media (max-width:1024px){.pillars{grid-template-columns:1fr 1fr}.pillar{min-height:180px}}
  @media (max-width:560px){.pillars{grid-template-columns:1fr}.pillar{min-height:150px}}

  /* 07 CTA */
  .cta{padding:0 0 clamp(72px,10vw,120px)}
  .cta-box{border-radius:32px;padding:clamp(48px,7vw,88px) clamp(24px,5vw,72px);color:#fff;text-align:center;position:relative;overflow:hidden;
    background:radial-gradient(600px 300px at 90% 0%,rgba(255,176,32,.35),transparent 60%),radial-gradient(700px 400px at 0% 100%,rgba(47,124,246,.55),transparent 60%),linear-gradient(135deg,#06173a,#0e3a86)}
  .cta-box h2{color:white;font-size:clamp(28px,4.4vw,52px);font-weight:800;letter-spacing:-.02em;line-height:1.12;max-width:780px;margin:0 auto 18px;text-wrap:balance}
  .cta-box > p{color:rgba(255,255,255,.75);max-width:560px;margin:0 auto 36px}
  .cta-btns{display:flex;justify-content:center;flex-wrap:wrap;gap:14px}
  .shortcuts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:760px;margin:48px auto 0}
  .shortcut{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 20px;border-radius:16px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);text-align:left;font-weight:600;transition:background .2s}
  .shortcut:hover{background:rgba(255,255,255,.16)}
  .shortcut small{display:block;font-weight:400;font-size:12px;color:rgba(255,255,255,.65)}
  .shortcut .go{font-size:18px;color:var(--accent)}
  @media (max-width:700px){.shortcuts{grid-template-columns:1fr}}

  .to-top{position:fixed;right:22px;bottom:24px;z-index:60;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:var(--blue);color:#fff;font-size:22px;font-weight:700;box-shadow:0 12px 30px -10px rgba(21,82,181,.55);transition:transform .2s,background .2s,box-shadow .2s}
  .to-top:hover{transform:translateY(-3px);background:var(--navy);box-shadow:0 16px 36px -10px rgba(10,42,94,.55)}
</style>
